# OPTIONAL ONLY: core app/Yahoo/chart/imports work without this file.
# Copy to local-data.env in this folder. Never share or commit the real file.
# Use your own Alpaca FREE Basic/paper account data keys, subject to eligibility.
# This app calls ONLY https://data.alpaca.markets/v2/stocks/... with feed=iex.
# It does not call paper/live trading, account, order or position endpoints.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional Webull Hong Kong Sandbox/Paper OpenAPI credentials.
# Prefer the named macOS Keychain entries documented in README.md. Never send
# these values through chat or commit/package local-data.env.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
